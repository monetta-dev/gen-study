LLM_PROVIDER=opencode-go
LLM_API_STYLE=anthropic
LLM_API_KEY=your_opencode_go_api_key_here
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_MODEL=qwen3.7-max
LLM_TIMEOUT_SECONDS=300
LLM_MAX_TOKENS=4096
LLM_ANTHROPIC_VERSION=2023-06-01
LLM_STREAM=true
LLM_USER_AGENT=gen-study/0.1 Python LLM client
LLM_THINKING_MODE=enabled
LLM_THINKING_BUDGET_TOKENS=1024
LLM_THINKING_DISPLAY=omitted
LLM_THINKING_FIELD=
LLM_RETRY_ATTEMPTS=1
LLM_RETRY_DELAY_SECONDS=10

# Backward-compatible direct DeepSeek settings. Leave these empty when using LLM_* above.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_TIMEOUT_SECONDS=300
GENERATION_TRACE=false
API_HOST=127.0.0.1
API_PORT=8000
API_DEBUG=false
API_MAX_BODY_BYTES=65536
API_ALLOWED_ORIGIN=*
GEN_STUDY_API_KEY=
