OPENCODE_GO_THINKING_ENABLED=true
OPENCODE_GO_THINKING_DISPLAY=omitted
OPENCODE_GO_RETRY_ATTEMPTS=1
OPENCODE_GO_RETRY_DELAY_SECONDS=10
