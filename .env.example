OPENAI_IMAGE_RETRY_ATTEMPTS=1
OPENAI_IMAGE_RETRY_DELAY_SECONDS=60
VISUAL_REPAIR_ATTEMPTS=2
MAX_REPAIR_ATTEMPTS=
GENERATION_TRACE=false
API_HOST=127.0.0.1
API_PORT=8000
